<article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-lg font-semibold text-slate-950">{{ recipe.name }}</h2>

    {% if recipe.description %}
        <p class="mt-3 text-sm leading-6 text-slate-600">{{ recipe.description }}</p>
    {% endif %}

    <div class="mt-5 flex gap-3 text-sm text-slate-600">
        <span class="rounded-md bg-slate-100 px-2.5 py-1">
            Préparation : {{ recipe.preparationTime }} min
        </span>
        <span class="rounded-md bg-slate-100 px-2.5 py-1">
            Cuisson : {{ recipe.cookingTime }} min
        </span>
    </div>

    <div class="mt-5 flex items-center gap-3 border-t border-slate-100 pt-4">
        <a
            href="{{ path('app_recipe_edit', {id: recipe.id}) }}"
            class="inline-flex size-9 items-center justify-center rounded-md border border-slate-300 bg-white text-slate-700 transition hover:bg-slate-50"
            aria-label="Modifier {{ recipe.name }}"
            title="Modifier"
        >
            {{ ux_icon('fa6-solid:pen-to-square', {class: 'size-4', 'aria-hidden': 'true', focusable: 'false'}) }}
        </a>

        <form method="post" action="{{ path('app_recipe_delete', {id: recipe.id}) }}" onsubmit="return confirm('Supprimer cette recette ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_recipe_' ~ recipe.id) }}">
            <button
                type="submit"
                class="inline-flex size-9 items-center justify-center rounded-md border border-red-200 bg-red-50 text-red-700 transition hover:bg-red-100"
                aria-label="Supprimer {{ recipe.name }}"
                title="Supprimer"
            >
                {{ ux_icon('fa6-solid:trash-can', {class: 'size-4', 'aria-hidden': 'true', focusable: 'false'}) }}
            </button>
        </form>
    </div>
</article>
