{{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}
    {{ form_row(form.name) }}
    {{ form_row(form.description) }}

    <div class="grid gap-5 md:grid-cols-2">
        {{ form_row(form.preparationTime) }}
        {{ form_row(form.cookingTime) }}
    </div>

    <div class="flex items-center gap-3 pt-2">
        <button class="rounded-md bg-slate-950 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-800">
            {{ button_label|default('Enregistrer') }}
        </button>

        <a href="{{ path('app_recipe') }}" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
            Annuler
        </a>
    </div>
{{ form_end(form) }}
